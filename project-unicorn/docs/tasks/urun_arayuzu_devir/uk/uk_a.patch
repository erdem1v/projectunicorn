+## Koşan aşamanın yüzdesi (barın dolgusuyla aynı kaynak: önden yapılan ve `done_at`); kart yetişmiyorsa ya da koşan aşama yoksa
+## yuvanın öbür parçaları kalır, varsa onların yerini alır.
+func _show_stage_pct(at: float) -> void:
+	if _pct == null:
+		return
+	var text := ""
+	if not card.late:
+		for entry: Dictionary in _live:
+			var s: Dictionary = entry.stage
+			if at >= s.start - SprintSystem.EPS and at < s.end - SprintSystem.EPS:
+				var made: float = s.pre + SprintTimeline.done_at(s, at)
+				var pct: float = floorf(clampf(made / (s.pre + s.need), 0.0, 1.0) * 100.0)
+				text = tr("PRODUCT_STAGE_PCT").format({"stage": tr(STAGE_NAMES[s.stage]), "pct": Fmt.percent(pct, 0)})
+				break
+	_pct.text = text
+	_pct.visible = text != ""
+	for part: Control in _status_cell.get_children():
+		if part != _pct:
+			part.visible = text == ""
