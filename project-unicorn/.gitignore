# Godot 4+ specific ignores
.godot/
/android/

# Mockup workspace: design sources (HTML, CSS, generators, icons) are tracked; renders, reference screenshots,
# logs and caches stay local.
/docs/mockups/**/*.png
/docs/mockups/**/*.jpg
/docs/mockups/**/*.log
/docs/mockups/**/*.txt
/docs/mockups/**/*.pyc
/docs/mockups/**/__pycache__/
/docs/mockups/**/*.import
