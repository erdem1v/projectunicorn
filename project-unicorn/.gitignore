# Godot 4+ specific ignores
.godot/
/android/

# Mockup workspace: sources and each screen's approved top-level renders are tracked;
# working renders, reference screenshots, logs and caches stay local.
/docs/mockups/**/*.png
!/docs/mockups/menajer/screens/*/*.png
!/docs/mockups/menajer/system/*.png
/docs/mockups/**/*.jpg
/docs/mockups/**/*.log
/docs/mockups/**/*.txt
/docs/mockups/**/*.pyc
/docs/mockups/**/__pycache__/
/docs/mockups/**/*.import

# Render and asset-lab audits: the PNG frames stay local, the md reports are tracked. The lab's downloaded
# packs, capture output and node_modules stay local.
/docs/audits/render/**/*.png
/docs/audits/asset_lab/**/*.png
/sandbox/asset_lab/packs/
/sandbox/asset_lab/out/
/sandbox/asset_lab/tools/**/node_modules/
