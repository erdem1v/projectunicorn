  "text": {
    "tr": {
      "title": "Kod incelemesi",
      "body": "{lead} kodumu üçüncü kez geri çevirdi. Haklı olabilir ama kart bu yüzden sprinte yetişmeyecek, artık ne yazsam yanlış geliyor.",
      "options": {
        "blockers_only": "{lead} yalnız hataya yol açacak notlarda dursun, gerisini geçsin",
        "pair_up": "{lead} ile {employee} bir gün aynı masaya otursun, notları birlikte kapatsınlar",
        "follow_up": "Kart bu sprintte bu hâliyle kalsın, {employee} notları sonraki sprintte düzeltsin",
        "close_all": "{employee} bu sefer notların hepsini kapatsın, kart sağlam çıksın"
      },
      "expire_note": "Cevap gelmedi, {employee} notları kendi başına kapattı; kartın işi büyüdü, morali düştü."
    },
    "en": {
      "title": "Code review",
      "body": "{lead} sent my code back for the third time. Maybe with good reason, but the card won't make the sprint now, and everything I write feels wrong.",
      "options": {
        "blockers_only": "{lead} only holds the card for notes that would cause bugs",
        "pair_up": "Sit {lead} and {employee} down together for a day to clear the notes",
        "follow_up": "Keep the card as it is this sprint, {employee} fixes the notes next sprint",
        "close_all": "{employee} closes every note this time, the card ships solid"
      },
      "expire_note": "No answer came, so {employee} closed the notes alone, which grew the card and cost morale."
    }
  },
  "expires_weeks": 1,
