  "text": {
    "tr": {
      "title": "Kendi renkleri",
      "body": {
        "by_seam": "urun.colors_again",
        "variants": {
          "0": "{customer}, ürünü daha çok çalışanına açmadan önce kendi logosunu ve renklerini görmek istiyor. Renkleri içeride değiştirmek {seam:urun.decision_card} işini geciktirir. Her sayfanın renkleri koda tek tek yazılmış, yeni sayfalar da öyle.",
          "1": "Renk değişikliğinden sonra eklenen her sayfa varsayılan renklerle çıktı. {customer} kendi renklerini her sayfada görmek istiyor. Bunu içeride yapmak {seam:urun.decision_card} işini geciktirir."
        }
      },
      "options": {
        "by_hand": "Renkleri elle değiştir",
        "one_file": "Bütün renkleri tek dosyaya topla",
        "as_is": "Renkler değişmeyecek de"
      },
      "expire_note": {
        "by_seam": "urun.colors_again",
        "variants": {
          "0": "Cevap gitmedi, {customer} bunu hayır diye anladı.",
          "1": "{customer} şikâyet etti, ekip sayfaları elle değiştirdi."
        }
      }
    },
    "en": {
      "title": "Their own colours",
      "body": {
        "by_seam": "urun.colors_again",
        "variants": {
          "0": "{customer} wants their logo and colours on the product before more of their staff use it. Changing them in house slows down {seam:urun.decision_card}. Every page has its colours written into the code, and new pages are no different.",
          "1": "Every page added since the colour change is in the default colours. {customer} wants their own on every page. Doing it in house slows down {seam:urun.decision_card}."
        }
      },
      "options": {
        "by_hand": "Change their colours by hand",
        "one_file": "Pull every colour into one file",
        "as_is": "Tell them the colours stay"
      },
      "expire_note": {
        "by_seam": "urun.colors_again",
        "variants": {
          "0": "No answer went back, so {customer} took it as a no.",
          "1": "{customer} complained, and the team changed the pages by hand."
        }
      }
