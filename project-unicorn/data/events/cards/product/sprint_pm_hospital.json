  "text": {
    "tr": {
      "title": "{dev} hastanede",
      "body": "{dev} acil bir durum yaşadı, hastanede ve iki hafta yok. Şirket olarak geçmiş olsun çiçeği gönderdik. Ama {customer} için geliştirdiği iş yarıda kaldı, ne yapalım?",
      "options": {
        "wait": "Kart {dev} dönene kadar beklesin",
        "hand_over": "Kartı başka bir geliştirici devralsın",
        "call_brief": "{dev} taburcu olunca on dakika arayıp kaldığı yeri anlatsın"
      },
      "locked_reasons": {
        "hand_over": "Ekipte kartı devralacak başka bir yazılımcı yok."
      },
      "expire_note": "Cevap gelmedi, kart {dev} dönene kadar bekledi."
    },
    "en": {
      "title": "{dev} is in hospital",
      "body": "{dev} had an emergency and is in hospital, out for two weeks. We sent get-well flowers from the team. But the work {dev} was building for {customer} is stuck halfway. What should we do?",
      "options": {
        "wait": "Let the card wait until {dev} is back",
        "hand_over": "Have another developer take over the card",
        "call_brief": "Ask {dev} for a ten-minute call after discharge to explain where things stand"
      },
      "locked_reasons": {
        "hand_over": "There is no other developer on the team to take the card."
      },
      "expire_note": "No answer came, so the card waited until {dev} was back."
    }
  },
  "expires_weeks": 1,
