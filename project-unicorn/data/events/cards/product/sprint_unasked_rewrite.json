        "review": "EV_PRODUCT_SPRINT_UNASKED_REWRITE_REVIEW",
        "read": "EV_PRODUCT_SPRINT_UNASKED_REWRITE_READ",
        "merge": "EV_PRODUCT_SPRINT_UNASKED_REWRITE_MERGE"
