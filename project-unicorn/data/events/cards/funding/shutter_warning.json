{
  "_port_note": "The telegraph the bankruptcy ending depends on. EndingsSystem._tick_shutter passes it to trigger_ending(\"bankruptcy\", \"funding.shutter_warning\"), so if this card ever stops firing the ending says so out loud (I3) instead of arriving unannounced.",

  "id": "funding.shutter_warning",
  "version_scope": "demo",
  "category": "funding",
  "tick": "daily",
  "class": "interrupt",
  "tags": ["critical", "build_safe", "terminal_warning"],
  "speaker": "char_mentor_frank",

  "latch": { "one_shot": true },

  "condition": {
    "all": [
      { "seam": "finance.cash", "op": "<", "value": 0 },
      { "seam": "finance.shutter_days_left", "op": ">=", "value": 0 }
    ]
  },

  "options": [
    {
      "id": "go_to_finance",
      "outcome_id": "warned",
      "effects": [
        { "verb": "stamp_day", "name": "shutter_warned" },
        { "verb": "goto_tab", "tab_id": "finance" }
      ]
    }
  ],

  "text": {
    "tr": {
      "title": "END_EV_SHUTTER_TITLE",
      "body": "END_EV_SHUTTER_BODY",
      "options": { "go_to_finance": "END_EV_GO_FINANCE" }
    },
    "en": {
      "title": "END_EV_SHUTTER_TITLE",
      "body": "END_EV_SHUTTER_BODY",
      "options": { "go_to_finance": "END_EV_GO_FINANCE" }
    }
  }
}
