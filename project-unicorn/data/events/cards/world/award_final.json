{
  "id": "world.award_final",
  "version_scope": "demo",
  "category": "world",
  "tick": "daily",
  "class": "paper",
  "sender": "press",
  "tags": [],
  "schema": 3,
  "family": "award",
  "family_subject": {
    "once": true
  },
  "delay_weeks": [
    1,
    6
  ],
  "plausibility": {
    "phase_band": [
      "bootstrap_team"
    ],
    "headcount": [
      1,
      null
    ],
    "product": "live",
    "modules": [],
    "min_week": 0,
    "subject_tenure_weeks": 4
  },
  "guards": {
    "product_live": true
  },
  "scope": {
    "employee": {
      "type": "employee",
      "required": true,
      "select": "top_skill:engineering",
      "subject": false,
      "where": {
        "entity_seam": "hr.role",
        "scope": "employee",
        "op": "==",
        "value": "developer"
      }
    },
    "founder": {
      "type": "founder",
      "required": true
    }
  },
  "latch": {
    "one_shot": true
  },
  "latch_key": "run",
  "condition": {
    "all": [
      {
        "seam": "phase.current",
        "op": "==",
        "value": 1
      },
      {
        "seam": "urun.is_live",
        "op": "==",
        "value": true
      }
    ]
  },
  "options": [
    {
      "id": "live_demo",
      "outcome_id": "live_demo",
      "effects": [
        {
          "verb": "productivity_mod",
          "scope": "founder",
          "pct": -20,
          "weeks": 1
        }
      ],
      "check": {
        "odds_seam": "olay.award_live_odds",
        "on_pass": [
          {
            "verb": "add_cash",
            "amount": 10000,
            "label": "award"
          },
          {
            "verb": "add_brand",
            "amount": 3
          }
        ],
        "on_fail": [
          {
            "verb": "add_brand",
            "amount_seam": "olay.award_live_slip"
          }
        ]
      }
    },
    {
      "id": "video",
      "outcome_id": "video",
      "effects": [
        {
          "verb": "productivity_mod",
          "scope": "employee",
          "pct": -40,
          "weeks": 1
        },
        {
          "verb": "add_brand",
          "amount": 2
        }
      ],
      "check": {
        "odds_seam": "olay.odds_15",
        "on_pass": [
          {
            "verb": "add_cash",
            "amount": 10000,
            "label": "award"
          }
        ],
        "on_fail": []
      }
    },
    {
      "id": "slides",
      "outcome_id": "slides",
      "effects": [
        {
          "verb": "productivity_mod",
          "scope": "founder",
          "pct": -10,
          "weeks": 1
        },
        {
          "verb": "add_brand",
          "amount": 1
        }
      ],
      "check": {
        "odds_seam": "olay.odds_10",
        "on_pass": [
          {
            "verb": "add_cash",
            "amount": 10000,
            "label": "award"
          }
        ],
        "on_fail": []
      }
    }
  ],
  "text": {
    "tr": {
      "title": "Finaldesiniz",
      "body": "“Yılın Yeni Girişimi” yarışmasında son beşe kaldınız, tebrikler. Final gelecek hafta: her ekibe jüri önünde yedi dakika veriliyor, birinciye 10 bin dolar ödül var. Sunumu nasıl yapacağınızı bu hafta teknik ekibimize bildirmeniz gerekiyor.",
      "options": {
        "live_demo": "Canlı demo yap",
        "video": "Önceden çekilmiş demo videosu göster",
        "slides": "Slaytla anlat"
      },
      "modifier_lines": {
        "urun.open_bugs": "Açık hatalar"
      },
      "expire_note": "Cevap gelmedi, jüriye sunum bildirilmedi ve Marka düştü."
    },
    "en": {
      "title": "You're in the final",
      "body": "Congratulations, you're one of five finalists for “New Startup of the Year.” The final is next week: each team gets seven minutes in front of the jury, and the winner takes home $10,000. Please let our tech crew know this week how you'll present.",
      "options": {
        "live_demo": "Do a live demo",
        "video": "Show a pre-recorded demo video",
        "slides": "Present with slides"
      },
      "modifier_lines": {
        "urun.open_bugs": "Open bugs"
      },
      "expire_note": "No answer came, so the jury never heard how you'd present and Brand dropped."
    }
  },
  "expires_weeks": 1,
  "on_expire": {
    "penalties": [
      {
        "verb": "add_brand",
        "amount": -1
      }
    ]
  },
  "expire_note": "expire_note"
}
