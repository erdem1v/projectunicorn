  "text": {
    "tr": {
      "title": "Verilerimiz nerede duruyor?",
      "body": "Dinleme haberlerinden sonra yönetimimiz tek bir soru sordu ve cevabı bu hafta istiyor: kayıtlarımız hangi ülkedeki sunucularda duruyor?",
      "options": {
        "founder_calls": "Bilgi işlem müdürünü sen ara, sunucu düzenini anlat",
        "send_all": "Bütün hesaplara aynı açıklamayı gönder",
        "lie": "“Verileriniz Türkiye'de ayrı bir sunucuya alınıyor” de"
      },
      "expire_note": "Cevap gelmedi, soru yanıtsız kaldı ve hesabın memnuniyeti düştü."
    },
    "en": {
      "title": "Where is our data?",
      "body": "After the surveillance stories in the papers, our board asked one question and wants the answer this week: which country are our records stored in?",
      "options": {
        "founder_calls": "Call their IT director yourself and walk through the server setup",
        "send_all": "Send the same statement to every account",
        "lie": "Tell them “your data is being moved to a separate server in Turkey”"
      },
      "expire_note": "No answer went out, the question stayed unanswered and the account's satisfaction dropped."
    }
  },
  "expires_weeks": 1,
  "on_expire": {
    "penalties": [
      {
        "verb": "trust_delta",
