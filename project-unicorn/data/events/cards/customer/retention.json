{
  "_port_note": "latch_key entity gives each account its own brake. tick: signal on `customer_health_changed`: the decision belongs to the EDGE into Risk, not the state — a daily tick would ask again every draw for as long as the account is dying — and the signal carries the customer id, so the emitter binds the slot. The cooldown is ONE day: the Sales tab's İlgilen button re-opens the same card, and the player may still rescue before expiry; what one day forbids is re-opening the card just answered, which is an undo, not a decision. Stall and discount each cost reputation, not brand: holding one account back is a private credibility cost, not a market-facing one.",
  "id": "customer.retention",
  "version_scope": "demo",
  "category": "customer",
  "tick": "signal",
  "class": "interrupt",
  "tags": [
    "build_safe"
  ],
  "guards": {
    "market": "b2b"
  },
  "scope": {
    "customer": {
      "type": "customer",
      "required": true,
      "select": "at_risk"
    }
  },
  "latch": {
    "cooldown_days": 1
  },
  "latch_key": "entity",
  "condition": {
    "entity_seam": "musteri.is_at_risk",
    "scope": "customer",
    "op": "==",
    "value": true,
    "reason": "the account is not in Risk with a countdown running"
  },
  "options": [
    {
      "id": "promise_it",
      "outcome_id": "promised",
      "requires": {
        "all": [
          {
            "entity_seam": "musteri.has_pain_feature",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "B2B_LOCK_NO_PAIN_TARGET"
          },
          {
            "entity_seam": "musteri.pain_feature_shipped",
            "scope": "customer",
            "op": "==",
            "value": false,
            "reason": "B2B_LOCK_PAIN_SHIPPED"
          },
          {
            "entity_seam": "musteri.pain_buildable",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "B2B_LOCK_PAIN_GATED"
          },
          {
            "entity_seam": "musteri.has_open_promise",
            "scope": "customer",
            "op": "==",
            "value": false,
            "reason": "B2B_LOCK_PROMISE_OPEN"
          }
        ]
      },
      "effects": [
        {
          "verb": "promise_create",
          "scope": "customer",
          "feature_id": "pain",
          "deadline_days": 14
        },
        {
          "verb": "add_reputation",
          "amount": 1
        }
      ]
    },
    {
      "id": "stall",
      "outcome_id": "stalled",
      "requires": {
        "entity_seam": "musteri.stalls_used",
        "scope": "customer",
        "op": "<",
        "value": 2,
        "reason": "B2B_LOCK_STALL_CAP"
      },
      "effects": [
        {
          "verb": "b2b_retain_delay",
          "scope": "customer"
        },
        {
          "verb": "add_reputation",
          "amount": -1
        }
      ]
    },
    {
      "id": "discount",
      "outcome_id": "discounted",
      "requires": {
        "entity_seam": "musteri.discounts_used",
        "scope": "customer",
        "op": "<",
        "value": 2,
        "reason": "B2B_DISCOUNT_SPENT_DESC"
      },
      "effects": [
        {
          "verb": "b2b_retain_discount",
          "scope": "customer"
        },
        {
          "verb": "add_reputation",
          "amount": -1
        }
      ]
    },
    {
      "id": "leave_alone",
      "outcome_id": "ignored",
      "effects": [
        {
          "verb": "b2b_retain_ignore",
          "scope": "customer"
        }
      ]
    }
  ],
  "text": {
    "tr": {
      "title": "B2B_EV_RISK_TITLE",
      "body": "{customer} hatta.\n\n\"{seam:musteri.risk_voice}\"",
      "options": {
        "promise_it": "B2B_CHOICE_PROMISE",
        "stall": "B2B_CHOICE_STALL",
        "discount": "B2B_CHOICE_DISCOUNT",
        "leave_alone": "B2B_CHOICE_LEAVE_ALONE"
      },
      "locked_reasons": {
        "promise_it": "B2B_LOCK_PROMISE_OPEN",
        "stall": "B2B_LOCK_STALL_CAP",
        "discount": "B2B_DISCOUNT_SPENT_DESC"
      },
      "expire_note": "B2B_EV_RISK_EXPIRED"
    },
    "en": {
      "title": "B2B_EV_RISK_TITLE",
      "body": "{customer} on the line.\n\n\"{seam:musteri.risk_voice}\"",
      "options": {
        "promise_it": "B2B_CHOICE_PROMISE",
        "stall": "B2B_CHOICE_STALL",
        "discount": "B2B_CHOICE_DISCOUNT",
        "leave_alone": "B2B_CHOICE_LEAVE_ALONE"
      },
      "locked_reasons": {
        "promise_it": "B2B_LOCK_PROMISE_OPEN",
        "stall": "B2B_LOCK_STALL_CAP",
        "discount": "B2B_DISCOUNT_SPENT_DESC"
      },
      "expire_note": "B2B_EV_RISK_EXPIRED"
    }
  },
  "_r8a_note": "A non-critical interrupt is demotable (§13.2), and a demoted card lands on the desk with a clock — which is the only reason paper is a safe floor for I4. So it carries the paper trio even though it usually renders as an interrupt.",
  "expires_days": 7,
  "on_expire": {
    "penalties": [
      {
        "verb": "b2b_retain_ignore",
        "scope": "customer"
      }
    ]
  },
  "expire_note": "expire_note",
  "trigger": {
    "signal": "customer_health_changed"
  }
}
