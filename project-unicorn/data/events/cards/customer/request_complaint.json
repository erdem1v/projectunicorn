{
  "version_scope": "demo",
  "category": "customer",
  "tick": "request",
  "class": "paper",
  "tags": [
    "build_safe"
  ],
  "guards": {
    "market": "b2b"
  },
  "scope": {
    "customer": {
      "type": "customer",
      "required": true,
      "select": "open_request"
    },
    "rep": {
      "type": "employee",
      "required": true,
      "select": "support_lead"
    }
  },
  "latch": {
    "cooldown_days": 14
  },
  "latch_key": "entity",
  "expires_days": 7,
  "expire_note": "expire_note",
  "_port_note": "tick: request — no sweep, no pool draw. CustomerRepSystem names this card when a request ages past CS_ESCALATE_AFTER_DAYS and the weekly ceiling has room; the ceiling is a desk policy, not a tempo rule, so it stays in that system. No `musteri.is_assigned` leaf: the rep slot is the desk lead (select support_lead), not the account's steward, so a founder-managed account still gets its request card. No discount row: a complaint is answered with the product or with honesty; price is the renewal card's lever.",
  "id": "customer.request_complaint",
  "condition": {
    "entity_seam": "musteri.request_kind",
    "scope": "customer",
    "op": "==",
    "value": "complaint"
  },
  "on_expire": {
    "penalties": [
      {
        "verb": "satisfaction_delta",
        "scope": "customer",
        "amount": -5
      }
    ]
  },
  "options": [
    {
      "id": "promise_it",
      "outcome_id": "promised",
      "effects": [
        {
          "verb": "promise_create",
          "scope": "customer",
          "feature_id": "pain",
          "deadline_days": 14
        }
      ],
      "requires": {
        "all": [
          {
            "entity_seam": "musteri.has_pain_feature",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "B2B_LOCK_NO_PAIN_TARGET"
          },
          {
            "entity_seam": "musteri.pain_feature_shipped",
            "scope": "customer",
            "op": "==",
            "value": false,
            "reason": "B2B_LOCK_PAIN_SHIPPED"
          },
          {
            "entity_seam": "musteri.pain_buildable",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "B2B_LOCK_PAIN_GATED"
          },
          {
            "entity_seam": "musteri.has_open_promise",
            "scope": "customer",
            "op": "==",
            "value": false,
            "reason": "B2B_LOCK_PROMISE_OPEN"
          }
        ]
      }
    },
    {
      "id": "explain",
      "outcome_id": "explained",
      "effects": [
        {
          "verb": "satisfaction_delta",
          "scope": "customer",
          "amount": 3
        }
      ]
    }
  ],
  "text": {
    "tr": {
      "title": "B2B_EV_COMPLAINT_TITLE",
      "body": "{customer} destek hattını aradı.\n\n\"{seam:musteri.complaint_voice}\"\n\nŞimdilik oyaladım. Onlara ne diyeyim?",
      "options": {
        "promise_it": "B2B_CHOICE_PROMISE_FIX",
        "explain": "B2B_CHOICE_TELL_TRUTH"
      },
      "expire_note": "B2B_EV_REQ_COMPLAINT_EXPIRED",
      "locked_reasons": {
        "promise_it": "B2B_LOCK_PROMISE_OPEN"
      }
    },
    "en": {
      "title": "B2B_EV_COMPLAINT_TITLE",
      "body": "{customer} called the support line.\n\n\"{seam:musteri.complaint_voice}\"\n\nI've kept them talking. What do I tell them?",
      "options": {
        "promise_it": "B2B_CHOICE_PROMISE_FIX",
        "explain": "B2B_CHOICE_TELL_TRUTH"
      },
      "expire_note": "B2B_EV_REQ_COMPLAINT_EXPIRED",
      "locked_reasons": {
        "promise_it": "B2B_LOCK_PROMISE_OPEN"
      }
    }
  }
}
