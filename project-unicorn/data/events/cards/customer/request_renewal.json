{
  "version_scope": "demo",
  "category": "customer",
  "tick": "request",
  "class": "paper",
  "tags": [
    "build_safe"
  ],
  "guards": {
    "market": "b2b"
  },
  "scope": {
    "customer": {
      "type": "customer",
      "required": true,
      "select": "open_request"
    },
    "rep": {
      "type": "employee",
      "required": true,
      "select": "support_lead"
    }
  },
  "latch": {
    "cooldown_days": 14
  },
  "latch_key": "entity",
  "expires_days": 7,
  "expire_note": "expire_note",
  "_port_note": "tick: request — no sweep, no pool draw. CustomerRepSystem names this card when a request ages past CS_ESCALATE_AFTER_DAYS and the weekly ceiling has room; the ceiling is a desk policy, not a tempo rule, so it stays in that system. No `musteri.is_assigned` leaf: the rep slot is the desk lead (select support_lead), not the account's steward, so a founder-managed account still gets its request card. The one request card with a discount row: at renewal a price cut is the honest lever.",
  "id": "customer.request_renewal",
  "condition": {
    "entity_seam": "musteri.request_kind",
    "scope": "customer",
    "op": "==",
    "value": "renewal"
  },
  "on_expire": {
    "penalties": [
      {
        "verb": "satisfaction_delta",
        "scope": "customer",
        "amount": -5
      }
    ]
  },
  "options": [
    {
      "id": "talk_it_through",
      "outcome_id": "talked",
      "effects": [
        {
          "verb": "satisfaction_delta",
          "scope": "customer",
          "amount": 4
        }
      ]
    },
    {
      "id": "discount_them",
      "outcome_id": "discounted",
      "effects": [
        {
          "verb": "b2b_retain_discount",
          "scope": "customer"
        }
      ],
      "requires": {
        "entity_seam": "musteri.discounts_used",
        "scope": "customer",
        "op": "<",
        "value": 2,
        "reason": "B2B_DISCOUNT_SPENT_DESC"
      }
    },
    {
      "id": "stall",
      "outcome_id": "stalled",
      "effects": [
        {
          "verb": "satisfaction_delta",
          "scope": "customer",
          "amount": -2
        }
      ]
    }
  ],
  "text": {
    "tr": {
      "title": "B2B_EV_RENEWAL_TITLE",
      "body": "B2B_EV_RENEWAL_BODY",
      "options": {
        "talk_it_through": "B2B_CHOICE_SIT_DOWN",
        "discount_them": "B2B_CHOICE_RENEW_LOWER",
        "stall": "B2B_CHOICE_LET_IT_WAIT"
      },
      "expire_note": "B2B_EV_REQ_RENEWAL_EXPIRED",
      "locked_reasons": {
        "discount_them": "B2B_DISCOUNT_SPENT_DESC"
      }
    },
    "en": {
      "title": "B2B_EV_RENEWAL_TITLE",
      "body": "B2B_EV_RENEWAL_BODY",
      "options": {
        "talk_it_through": "B2B_CHOICE_SIT_DOWN",
        "discount_them": "B2B_CHOICE_RENEW_LOWER",
        "stall": "B2B_CHOICE_LET_IT_WAIT"
      },
      "expire_note": "B2B_EV_REQ_RENEWAL_EXPIRED",
