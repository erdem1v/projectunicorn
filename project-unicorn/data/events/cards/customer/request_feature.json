{
  "version_scope": "demo",
  "category": "customer",
  "tick": "request",
  "class": "paper",
  "tags": [
    "build_safe"
  ],
  "guards": {
    "market": "b2b"
  },
  "scope": {
    "customer": {
      "type": "customer",
      "required": true,
      "select": "open_request"
    },
    "rep": {
      "type": "employee",
      "required": true,
      "select": "support_lead"
    }
  },
  "latch": {
    "cooldown_days": 14
  },
  "latch_key": "entity",
  "expires_days": 7,
  "expire_note": "expire_note",
  "_port_note": "tick: request — no sweep, no pool draw. CustomerRepSystem names this card when a request ages past CS_ESCALATE_AFTER_DAYS and the weekly ceiling has room; the ceiling is a desk policy, not a tempo rule, so it stays in that system. No `musteri.is_assigned` leaf: the rep slot is the desk lead (select support_lead), not the account's steward, so a founder-managed account still gets its request card. 'On the list' is only +3: a soft yes without a date must weigh less than a promise.",
  "id": "customer.request_feature",
  "condition": {
    "entity_seam": "musteri.request_kind",
    "scope": "customer",
    "op": "==",
    "value": "feature"
  },
  "on_expire": {
    "penalties": [
      {
        "verb": "satisfaction_delta",
        "scope": "customer",
        "amount": -5
      }
    ]
  },
  "options": [
    {
      "id": "promise_it",
      "outcome_id": "promised",
      "effects": [
        {
          "verb": "promise_create",
          "scope": "customer",
          "feature_id": "pain",
          "deadline_days": 14
        }
      ],
      "requires": {
        "all": [
          {
            "entity_seam": "musteri.has_pain_feature",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "B2B_LOCK_NO_PAIN_TARGET"
          },
          {
            "entity_seam": "musteri.pain_feature_shipped",
            "scope": "customer",
            "op": "==",
            "value": false,
            "reason": "B2B_LOCK_PAIN_SHIPPED"
          },
          {
            "entity_seam": "musteri.pain_buildable",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "B2B_LOCK_PAIN_GATED"
          },
          {
            "entity_seam": "musteri.has_open_promise",
            "scope": "customer",
            "op": "==",
            "value": false,
            "reason": "B2B_LOCK_PROMISE_OPEN"
          }
        ]
      }
    },
    {
      "id": "prioritise",
      "outcome_id": "prioritised",
      "effects": [
        {
          "verb": "satisfaction_delta",
          "scope": "customer",
          "amount": 3
        }
      ]
    },
    {
      "id": "decline",
      "outcome_id": "declined",
      "effects": [
        {
          "verb": "satisfaction_delta",
          "scope": "customer",
          "amount": -4
        }
      ]
    }
  ],
  "text": {
    "tr": {
      "title": "B2B_EV_REQUEST_TITLE",
      "body": "{customer} ürünün henüz yapmadığı bir şey istiyor: {seam:musteri.pain_feature_label}.\n\nNe zaman diye sordular. Öğrenip döneceğimi söyledim.",
      "options": {
        "promise_it": "B2B_CHOICE_GIVE_DATE",
        "prioritise": "B2B_CHOICE_ON_THE_LIST",
        "decline": "B2B_CHOICE_NOT_NOW_SAY"
      },
      "expire_note": "B2B_EV_REQ_FEATURE_EXPIRED",
      "locked_reasons": {
        "promise_it": "B2B_LOCK_PROMISE_OPEN"
      }
    },
    "en": {
      "title": "B2B_EV_REQUEST_TITLE",
      "body": "{customer} wants something the product doesn't do yet: {seam:musteri.pain_feature_label}.\n\nThey asked when. I said I'd find out.",
      "options": {
        "promise_it": "B2B_CHOICE_GIVE_DATE",
        "prioritise": "B2B_CHOICE_ON_THE_LIST",
        "decline": "B2B_CHOICE_NOT_NOW_SAY"
      },
      "expire_note": "B2B_EV_REQ_FEATURE_EXPIRED",
      "locked_reasons": {
        "promise_it": "B2B_LOCK_PROMISE_OPEN"
      }
    }
  }
}
