  "latch": {
    "cooldown_weeks": 26
  },
  "latch_key": "entity",
  "scope": {
    "customer": {
      "type": "customer",
      "required": true,
      "select": "random",
      "where": {
        "all": [
          {
            "entity_seam": "musteri.scale",
            "scope": "customer",
            "op": "<=",
            "value": 2
          },
          {
            "entity_seam": "musteri.tenure_weeks",
            "scope": "customer",
            "op": ">=",
            "value": 4
          },
          {
            "entity_seam": "musteri.tenure_weeks",
            "scope": "customer",
            "op": "<=",
            "value": 5
          }
        ]
      }
    },
    "rep": {
      "type": "employee",
      "required": true,
      "select": "account_rep"
    }
  },
  "condition": {
    "all": [
      {
        "seam": "sales.is_b2b",
        "op": "==",
        "value": true
      },
      {
        "seam": "urun.line_tier.line_shared_integrations",
        "op": "==",
        "value": 0
      }
    ]
  },
  "options": [
    {
      "id": "queue_request",
      "outcome_id": "queue_request",
      "requires": {
        "all": [
          {
            "entity_seam": "musteri.can_request.line_shared_integrations",
            "scope": "customer",
            "op": "==",
            "value": true,
            "reason": "EV_LOCK_REQUEST_CLOSED"
          }
        ]
      },
      "effects": [
        {
          "verb": "queue_card",
          "scope": "customer",
          "line": "line_shared_integrations"
        },
        {
          "verb": "trust_delta",
          "scope": "customer",
          "amount": 8
        }
      ]
    },
    {
      "id": "rep_shows",
      "outcome_id": "rep_shows",
      "effects": [
        {
          "verb": "productivity_mod",
          "scope": "rep",
          "pct": -20,
          "weeks": 1
        },
        {
          "verb": "trust_delta",
          "scope": "customer",
          "amount": 4
        }
      ]
    },
    {
      "id": "carry_on",
      "outcome_id": "carry_on",
      "effects": [
        {
          "verb": "trust_delta",
          "scope": "customer",
          "amount": -8
        }
      ]
    }
  ],
  "text": {
    "tr": {
      "title": "Finans ekibimiz",
      "body": "Finans ekibimiz sizin sisteme girmek istemiyor. Ay sonunda bütün satışları ve alışları kendi tablolarına aktarıyorlar, her ay iki günleri bununla geçiyor. Bunu kolaylaştırmanın bir yolu var mı?",
      "options": {
        "queue_request": "Tabloya aktarmayı sonraki sprinte al",
        "rep_shows": "{rep} finans ekibine bir gün sistemi göstersin",
        "carry_on": "Şimdilik böyle devam etmelerini rica et"
      },
      "locked_reasons": {
        "queue_request": "EV_LOCK_REQUEST_CLOSED"
      },
      "expire_note": "Cevap gitmedi, {customer} finans ekibi tabloları elle doldurmaya devam etti."
    },
    "en": {
      "title": "Our finance team",
      "body": "Our finance team doesn't want to work in your system. At month end they copy every sale and purchase into their own spreadsheets, and it eats two days every month. Is there a way to make this easier?",
      "options": {
        "queue_request": "Put spreadsheet export in the next sprint",
        "rep_shows": "{rep} spends a day showing their finance team the system",
        "carry_on": "Ask them to carry on like this for now"
      },
      "locked_reasons": {
        "queue_request": "EV_LOCK_REQUEST_CLOSED"
      },
      "expire_note": "No answer went back, and the finance team at {customer} kept filling in their spreadsheets by hand."
    }
  },
  "expires_weeks": 2,
  "on_expire": {
    "penalties": [
      {
        "verb": "trust_delta",
        "scope": "customer",
        "amount": -8
      }
    ]
  },
  "expire_note": "expire_note"
}
