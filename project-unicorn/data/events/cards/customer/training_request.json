  },
  "delay_weeks": [
    0,
    0
  ],
  "delay_reason": "imzanın ertesi haftası: dar pencere",
  "plausibility": {
    "phase_band": [
      "bootstrap_team",
      "traction",
      "series_a"
    ],
    "headcount": [
      1,
      null
    ],
    "product": "live",
    "modules": [],
    "min_week": 0,
    "subject_tenure_by_slot": {
