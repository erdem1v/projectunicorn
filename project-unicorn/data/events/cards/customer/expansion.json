    "penalties": [
      {
        "verb": "b2b_expand_decline",
        "scope": "customer"
      }
    ]
  },
  "condition": {
    "entity_seam": "musteri.is_expansion_ready",
    "scope": "customer",
    "op": "==",
    "value": true
  },
  "options": [
    {
      "id": "expand",
      "outcome_id": "expanded",
      "effects": [
