{
  "_port_note": "The brake is the card's own entity-keyed one_shot latch: one expansion offer per account. class: paper — good news with no deadline behind it belongs on §11.4's desk, not in a modal, and the expiry gives the offer its shape: take it or it lapses.",
  "id": "customer.expansion",
  "version_scope": "demo",
  "category": "customer",
  "tick": "daily",
  "class": "paper",
  "tags": [
    "build_safe"
  ],
  "guards": {
    "market": "b2b"
  },
  "scope": {
    "customer": {
      "type": "customer",
      "required": true,
      "select": "expansion_ready"
    }
  },
  "latch": {
    "one_shot": true
  },
  "latch_key": "entity",
  "expires_days": 14,
  "expire_note": "expire_note",
