{
  "id": "team.password_rule",
  "version_scope": "demo",
  "category": "team",
  "sender": "self",
  "tick": "daily",
  "class": "paper",
  "tags": [],
  "guards": {
    "product_live": true
  },
  "scope": {
    "employee": {
      "type": "employee",
      "required": true,
      "select": "most_senior",
      "where": {
        "all": [
          {
            "entity_seam": "hr.level",
            "scope": "employee",
            "op": ">=",
            "value": 1
          },
          {
            "entity_seam": "hr.tenure_weeks",
            "scope": "employee",
            "op": ">=",
            "value": 4
          },
          {
            "entity_seam": "hr.account_count",
            "scope": "employee",
            "op": "==",
            "value": 0
          }
        ]
      }
    },
    "founder": {
      "type": "founder",
      "required": true
    }
  },
  "latch": {
    "one_shot": true
  },
  "condition": {
    "all": [
      {
        "seam": "phase.current",
        "op": "in",
        "value": [
          1,
          2
        ]
      },
      {
        "seam": "urun.sprint_running",
        "op": "==",
        "value": true
      },
      {
        "seam": "urun.sprint_week",
        "op": "==",
        "value": 2
      },
      {
        "seam": "urun.axis_stability",
        "op": "<",
        "value": 10
      },
      {
        "seam": "urun.enterprise_trust",
        "op": "==",
        "value": false
      }
    ]
  },
  "options": [
    {
      "id": "rule",
      "outcome_id": "ruled",
      "effects": [
        {
          "verb": "productivity_mod",
          "scope": "employee",
          "pct": -20,
          "weeks": 2
        },
        {
          "verb": "change_morale",
          "scope": "employee",
          "amount": -6
        }
      ]
    },
    {
      "id": "self",
      "outcome_id": "wrote_it",
      "effects": [
        {
          "verb": "productivity_mod",
          "scope": "founder",
          "pct": -30,
          "weeks": 2
        },
        {
          "verb": "change_morale",
          "scope": "employee",
          "amount": -3
        }
      ]
    },
    {
      "id": "outside",
      "outcome_id": "contracted",
      "effects": [
        {
          "verb": "add_cash",
          "amount": -2000,
          "label": "contractor"
        },
        {
          "verb": "change_morale",
          "scope": "employee",
          "amount": -3
        }
      ]
    },
    {
      "id": "leave",
      "outcome_id": "left_to_them",
      "requires": {
        "seam": "urun.sprint_running",
        "op": "==",
        "value": true,
        "reason": "EV_LOCK_NO_SPRINT"
      },
      "effects": [
        {
          "verb": "change_morale",
          "scope": "employee",
          "amount": 4
        },
        {
          "verb": "productivity_mod",
          "scope": "team",
          "pct": -15,
          "weeks": 2
        }
      ]
    }
  ],
  "text": {
    "tr": {
      "title": "EV_TEAM_PASSWORD_RULE_TITLE",
      "body": "EV_TEAM_PASSWORD_RULE_BODY",
      "options": {
        "rule": "EV_TEAM_PASSWORD_RULE_RULE",
        "self": "EV_TEAM_PASSWORD_RULE_SELF",
        "outside": "EV_TEAM_PASSWORD_RULE_OUTSIDE",
        "leave": "EV_TEAM_PASSWORD_RULE_LEAVE"
      },
      "locked_reasons": {
        "leave": "EV_LOCK_NO_SPRINT"
      },
      "expire_note": "EV_TEAM_PASSWORD_RULE_EXPIRED"
    },
    "en": {
      "title": "EV_TEAM_PASSWORD_RULE_TITLE",
      "body": "EV_TEAM_PASSWORD_RULE_BODY",
      "options": {
        "rule": "EV_TEAM_PASSWORD_RULE_RULE",
        "self": "EV_TEAM_PASSWORD_RULE_SELF",
        "outside": "EV_TEAM_PASSWORD_RULE_OUTSIDE",
        "leave": "EV_TEAM_PASSWORD_RULE_LEAVE"
      },
      "locked_reasons": {
        "leave": "EV_LOCK_NO_SPRINT"
      },
      "expire_note": "EV_TEAM_PASSWORD_RULE_EXPIRED"
    }
  },
  "expires_weeks": 1,
  "on_expire": {
    "penalties": [
      {
        "verb": "add_reputation",
        "amount": -2
      }
    ]
  },
  "expire_note": "expire_note"
}
