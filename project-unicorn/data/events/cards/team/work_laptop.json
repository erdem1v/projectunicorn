    },
    "en": {
      "title": "A work laptop",
      "body": "Boss, I'm on my own laptop for now, but you're sending me a work one, right? Mine sounds like a plane taking off every time I turn it on.",
      "options": {
        "send_new": "Send a new laptop",
        "send_old": "Send your own old laptop"
      },
      "expire_note": "No answer came, so they kept working on their own laptop; morale dropped and work slowed."
